FROM ubuntu:22.04 AS go

ARG aptproxy=""
ARG GOVERSION="1.27.3"
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /home/pufferpanel/build

RUN apt-get update && \
    apt-get install -y build-essential wget tar && \
    wget https://go.dev/dl/go${GOVERSION}.linux-amd64.tar.gz && \
    rm -rf /usr/local/go && tar -C /usr/local -xzf go*.linux-amd64.tar.gz && \
    apt-get clean && \
    rm -rf /var/cache/apt/archives

ENV CGOENABLED=1
ENV PATH="$PATH:/usr/local/go/bin"

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY . .

ARG GOPROXY=""
RUN go build -v -buildvcs=false -o /home/pufferpanel/templatetester github.com/pufferpanel/pufferpanel/v3/tools/templatetester

FROM ubuntu:22.04 AS final

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="$PATH:/usr/local/go/bin"
ENV NODE_MAJOR=26
ENV NODE_VERSION=26.10.0

ARG aptproxy=""

RUN apt-get update && \
    apt-get install -y gnupg apt-transport-https ca-certificates software-properties-common curl && \
    curl -fsSL https://download.mono-project.com/repo/xamarin.gpg -o /tmp/mono-official-archive-keyring.asc && \
    gpg --show-keys --with-colons /tmp/mono-official-archive-keyring.asc | grep -q '^fpr:::::::::3FA7E0328081BFF6A14DA29AA6A19B38D3D831EF:$' && \
    gpg --dearmor --output /usr/share/keyrings/mono-official-archive-keyring.gpg /tmp/mono-official-archive-keyring.asc && \
    rm /tmp/mono-official-archive-keyring.asc && \
    echo "deb [signed-by=/usr/share/keyrings/mono-official-archive-keyring.gpg] https://download.mono-project.com/repo/ubuntu stable-focal main" > /etc/apt/sources.list.d/mono-official-stable.list && \
    dpkg --add-architecture i386 && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" > /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y wget build-essential zip unzip tar git xz-utils nodejs=$NODE_VERSION-1nodesource1 lib32gcc-s1 libstdc++6 libstdc++6:i386 libtinfo6:i386 libncurses6:i386 libcurl3-gnutls:i386 mono-complete default-jre-headless && \
    apt-get clean && \
    rm -rf /var/cache/apt/archives && \
    useradd pufferpanel && \
    mkdir /home/pufferpanel && \
    chown -R pufferpanel:pufferpanel /home/pufferpanel

WORKDIR /home/pufferpanel
COPY --from=go /usr/local/go /usr/local/go
COPY --from=go /home/pufferpanel/templatetester /home/pufferpanel/templatetester

#USER pufferpanel

ENTRYPOINT ["./templatetester"]
CMD []