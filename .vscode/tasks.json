{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "yarn-install-client",
            "command": "yarn",
            "args": [
                "install"
            ],
            "options": {
                "cwd": "${workspaceFolder}/client"
            }
        },
        {
            "label": "yarn-build",
            "command": "yarn",
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}/client"
            },
            "dependsOn": [
                "yarn-install-client"
            ]
        },
        {
            "label": "out-configure",
            "command": "mkdir",
            "args": [
                "-p",
                "out"
            ]
        },
        {
            "label": "go-requirements",
            "dependsOn": [
                "out-configure",
                "yarn-install-client",
                "yarn-build"
            ]
        },
        {
            "label": "test-packages",
            "command": "go",
            "args": [
                "test",
                "-v",
                "./..."
            ],
            "dependsOn": [
                "out-configure",
                "yarn-build"
            ],
            "group": "test"
        },
        {
            "label": "run-swaggo",
            "type": "shell",
            "command": "go",
            "args": [
                "tool",
                "swag",
                "init",
                "--pd",
                "--md",
                ".",
                "-o",
                "web/swagger",
                "-g",
                "web/loader.go"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}